{
  "id": "sam3-segmentation",
  "name": "SAM3 3D Reconstruction",
  "version": "1.0.0",
  "description": "图像分割 + 3D模型生成",
  "icon": "cube",
  "launcher": {
    "enabled": true,
    "type": "webview",
    "label": "SAM3",
    "category": "3d",
    "pinnable": true,
    "entry": {
      "action": "route",
      "url": "/plugins/sam3-segmentation"
    }
  },
  "modes": {
    "auto": {
      "label": "自动识别",
      "description": "LLM + 视觉模型自动识别目标",
      "trigger": "/sam3-auto",
      "mcp_tool": "sam3_auto_segment",
      "requires_llm": true,
      "requires_image": true
    }
  },
  "backend_routes": "backend/routes.py",
  "output_types": ["model_3d", "image"],
  "dependencies": {
    "servers": ["sam3_inference:9999", "3d_generation:8000"]
  }
}

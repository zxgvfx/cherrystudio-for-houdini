{
  "id": "ai-pipeline-bridge",
  "name": "AI Pipeline",
  "version": "0.6.0",
  "description": "AI 工作流中心的桥接后端与兼容 API。工作流通过 Cherry 内置侧边栏统一访问；开发者不需要再为每个 workflow 新增插件图标。配置：PIPELINE_API_BASE 或 ~/.cherrystudio/ai-pipeline-bridge.json",
  "icon": "cube",
  "launcher": {
    "enabled": false,
    "type": "webview",
    "label": "AI Pipeline",
    "category": "ai",
    "pinnable": true,
    "entry": {
      "action": "route",
      "url": "/plugins/ai-pipeline-bridge"
    }
  },
  "backend_routes": "backend/routes.py",
  "output_types": ["model_3d", "image", "motion", "animation"],
  "dependencies": {
    "servers": ["ai_pipeline_api:9331"]
  }
}
